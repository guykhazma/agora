# Copy to `.env` and fill in values. Real `.env` is gitignored.

# --- GitHub (required for GitHub crawl) ---
# https://github.com/settings/tokens
GITHUB_TOKEN=

# --- OpenAI (recommended for first full seed / re-enrich) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
LLM_REQUEST_DELAY=0.5

# --- Optional alternatives (auto-detected if set; see llm/client.py) ---
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GOOGLE_API_KEY=

# Single secret for CI (optional): some setups use LLM_API_KEY instead of provider-specific vars
# LLM_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001

# --- Optional ---
# YOUTUBE_API_KEY=

# python-dotenv: crawl.py / generate_digest.py load .env from repo root when present
